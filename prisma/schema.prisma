// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Spell {
    id            Int      @id @default(autoincrement())
    name          String   @unique
    type          String
    casting_time  String
    range         String
    components    String
    duration      String
    description   String
    higher_levels String?
    classes       String[]
}

model Quest {
    id          Int      @id @default(autoincrement())
    name        String
    campaign    Campaign @relation(fields: [campaignId], references: [id])
    campaignId  Int
    NPC         NPC?     @relation(fields: [NPCId], references: [id])
    NPCId       Int?
    description String[]
    shortDesc   String
    level       Int      @default(1)
    location    String
    rewards     String
    active      Boolean  @default(true)

    @@unique([campaignId, name])
}

model Campaign {
    id      Int      @id @default(autoincrement())
    name    String
    dm      String
    players String[]
    quest   Quest[]
    NPC     NPC[]
    guildId Int
}

model NPC {
    id          Int      @id @default(autoincrement())
    name        String
    description String
    campaign    Campaign @relation(fields: [campaignId], references: [id])
    campaignId  Int
    quests      Quest[]
    portrait    Bytes
}

model PlayerCharacter {
    id          Int     @id @default(autoincrement())
    owner       String
    name        String
    class       Class
    level       Int     @default(1)
    stats       Int[]   @default([10, 10, 10, 10, 10, 10])
    proficiency Skill[]
    expertise   Skill[]
}

enum Class {
    Barbarian
    Bard
    Cleric
    Druid
    Fighter
    Monk
    Paladin
    Ranger
    Rogue
    Sorcerer
    Warlock
    Wizard
}

enum Skill {
    Acrobatics
    AnimalHandling
    Arcana
    Athletics
    Deception
    History
    Insight
    Intimidation
    Investigation
    Medicine
    Nature
    Perception
    Performance
    Persuasion
    Religion
    Stealing
    Stealth
    Survival
}
