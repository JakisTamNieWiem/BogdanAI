import { PrismaClient } from '@prisma/client';
import { BaseInteraction, SlashCommandBuilder } from 'discord.js';

export default {
	data: new SlashCommandBuilder()
		.setName('temp')
		.setDescription('temporary')
		.addStringOption((option) => option.setName('temp').setDescription('temporary').setRequired(true)),
	async execute(interaction: BaseInteraction, db: PrismaClient) {
		if (interaction.isChatInputCommand()) {
			interaction.reply({ content: 'reply' });
		}
		else if (interaction.isAutocomplete()) {
			const focusedValue = interaction.options.getFocused(true);
			const choices = [];

			interaction.respond(choices.map((choice) => { return { name: '', value: '' }; }));
		}
	},
};